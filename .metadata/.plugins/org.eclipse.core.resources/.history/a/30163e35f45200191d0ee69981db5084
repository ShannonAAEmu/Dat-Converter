package info.aaemu.converter.dat.gui;

import javax.swing.JFrame;

import com.alee.laf.WebLookAndFeel;

import info.aaemu.converter.dat.entity.GetData;

import javax.swing.JTextField;
import javax.swing.filechooser.FileFilter;
import javax.imageio.ImageIO;
import javax.swing.ImageIcon;
import javax.swing.JButton;
import javax.swing.JFileChooser;
import java.awt.event.MouseAdapter;
import java.awt.event.MouseEvent;
import java.io.File;
import java.io.IOException;
import java.net.URL;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.awt.Color;
import java.awt.Dimension;

import javax.swing.JLabel;
import java.awt.Font;
import java.awt.Image;
import java.awt.Toolkit;
import javax.swing.SwingConstants;

public class Gui {

	private final String FILTERS = ".dat";
	private final String DESCRIPTION = "Only map's dat files";

	private File userDir;
	private File selectedFile;
	private Path datFile;
	
	private GetData getData;

	private JFrame frame;
	private JTextField fileNameTF;
	private JButton openFileBtn;
	private JFileChooser fileChooser;

	private String userDirLocation;

	public Gui() throws IOException {
		initialize();
		getData = new GetData();
	}

	private void initialize() throws IOException {
		WebLookAndFeel.install();
		frame = new JFrame();
		URL iconURL = getClass().getResource("info/aaemu/converter/dat/imgs/icon.ico");
		ImageIcon icon = new ImageIcon(iconURL);
		frame.setIconImage(icon.getImage());
		frame.setIconImage(ImageIO.read(new File("info/aaemu/converter/dat/imgs/icon.ico")));
		//frame.setIconImage(new javax.swing.ImageIcon(getClass().getResource("info/aaemu/converter/dat/imgs/icon.ico")).getImage());
		frame.setTitle("AAEmu converters");
		frame.getContentPane().setBackground(new Color(34, 36, 49));
		frame.setResizable(false);
		frame.setBounds(100, 100, 250, 130);
		frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
		frame.getContentPane().setLayout(null);

		fileNameTF = new JTextField();
		fileNameTF.setBackground(new Color(34, 36, 49));
		fileNameTF.setBounds(10, 11, 224, 23);
		frame.getContentPane().add(fileNameTF);
		fileNameTF.setColumns(10);

		openFileBtn = new JButton("Select file");
		openFileBtn.addMouseListener(new MouseAdapter() {
			@Override
			public void mouseReleased(MouseEvent arg) {
				try {
					setFolder();
					selectFile();
				} catch (IOException e) {
					e.printStackTrace();
				}
			}
		});
		openFileBtn.setBounds(10, 45, 224, 25);
		frame.getContentPane().add(openFileBtn);

		JLabel infoLable = new JLabel("Map's .dat files");
		infoLable.setHorizontalAlignment(SwingConstants.CENTER);
		infoLable.setFont(new Font("Tahoma", Font.PLAIN, 12));
		infoLable.setForeground(new Color(153, 204, 102));
		infoLable.setBounds(10, 80, 80, 14);
		frame.getContentPane().add(infoLable);
		
		JLabel byLabel = new JLabel(" by Shannon");
		byLabel.setFont(new Font("Tahoma", Font.PLAIN, 12));
		byLabel.setForeground(new Color(153, 102, 255));
		byLabel.setBounds(160, 81, 74, 14);
		frame.getContentPane().add(byLabel);
		centreWindow(frame);
		frame.setVisible(true);

	}

	private void setFolder() {
		if (datFile != null) {
			userDirLocation = datFile.getParent().toAbsolutePath().toString();
		}else {
			userDirLocation = System.getProperty("user.dir");
		}
		userDir = new File(userDirLocation);
		fileChooser = new JFileChooser(userDir);
		fileChooser.setFileSelectionMode(JFileChooser.FILES_ONLY);
		fileChooser.setFileFilter(new FileFilter() {

			@Override
			public String getDescription() {
				return DESCRIPTION;
			}

			@Override
			public boolean accept(File f) {
				if (f != null) {
					if (f.isDirectory())
						return true;
					if (FILTERS == null)
						return (FILTERS.length() == 0);
					return f.getName().endsWith(FILTERS);
				}
				return false;
			}
		});
	}

	private void selectFile() throws IOException {
		if (fileChooser.showOpenDialog(openFileBtn) == JFileChooser.APPROVE_OPTION) {
			selectedFile = fileChooser.getSelectedFile();
			datFile = Paths.get(selectedFile.getAbsolutePath()).toAbsolutePath();
			if (selectedFile.getName().endsWith("doodad.dat")) {
				fileNameTF.setForeground(new Color(0, 153, 204));
			}else {
				fileNameTF.setForeground(new Color(255, 255, 51));
			}
			fileNameTF.setText(selectedFile.getName());
			getData.convert(datFile);
		}
	}
	
	public static void centreWindow(JFrame frame) {
	    Dimension dimension = Toolkit.getDefaultToolkit().getScreenSize();
	    int x = (int) ((dimension.getWidth() - frame.getWidth()) / 2);
	    int y = (int) ((dimension.getHeight() - frame.getHeight()) / 2);
	    frame.setLocation(x, y);
	}
}